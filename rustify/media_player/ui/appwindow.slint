// media_player/ui/appwindow.slint

import { ListView, Button, Slider, VerticalBox, HorizontalBox } from "std-widgets.slint";

export struct UiPanningNode {
    id: int,
    pan: float,
    source_id: int,
}

export struct UiPlayerNode {
    id: int,
    source_path: string,
}

export component AppWindow inherits Window {
    in property <[UiPanningNode]> pans;

    callback connect(int, int, string);

    callback add_panning();
    callback remove_pan_node(int);
    callback set_pan(int, float);


    in property <[UiPlayerNode]> players;

    callback add_player();
    callback remove_player(int);
    callback set_player_path(int, string);
    callback play_player(int);
    callback pause_player(int);
    callback stop_player(int);
    callback resume_player(int);

    

    VerticalLayout {
        HorizontalBox {
            VerticalBox {
                Button {
                    text: "+ Panning Node";
                    clicked => add_panning();
                }

                ListView {
                    for node in root.pans : Rectangle {
                        height: 40px;

                        HorizontalLayout {
                            Text { text: "Node: " + node.id; }

                            Slider {
                                value: node.pan;
                                changed(value) => set_pan(node.id, value);
                            }

                            TextInput {
                                text: node.source_id;
                                width: 60px;

                                edited => connect(node.id, 0, self.text);
                            }

                            Button {
                                text: "X";
                                clicked => remove_pan_node(node.id);
                            }
                        }
                    }
                }
            }

            VerticalBox {
                Button {
                    text: "+ Player Node";
                    clicked => add_player();
                }
                ListView {
                    for node in root.players : Rectangle {
                        height: 40px;
                        VerticalLayout {
                            HorizontalLayout {
                                Text { text: "Node: " + node.id; }

                                TextInput {
                                    text: node.source_path;
                                    width: 60px;

                                    edited => set_player_path(node.id, self.text);
                                }

                                Button {
                                    text: "X";
                                    clicked => remove_player(node.id);
                                }
                            }
                            HorizontalLayout {
                                Button {
                                    text: "Play";
                                    clicked => play_player(node.id);
                                }

                                Button {
                                    text: "Pause";
                                    clicked => pause_player(node.id);
                                }

                                Button {
                                    text: "Resume";
                                    clicked => resume_player(node.id);
                                }

                                Button {
                                    text: "Stop";
                                    clicked => stop_player(node.id);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}