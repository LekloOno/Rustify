// media_player/ui/appwindow.slint

import { ComboBox, ListView, Button, Slider, VerticalBox, HorizontalBox } from "std-widgets.slint";

export struct UiPanningNode {
    id: int,
    pan: float,
    source_id: int,
}

export struct UiPlayerNode {
    id: int,
    source_path: string,
}

export struct UiMixerNode {
    id: int,
}

export struct UiDistorsionNode {
    id: int,
    type: string,
    source_id: int,
}

export struct UiGainNode {
    id: int,
    gain: float,
    source_id: int,
}

export struct UiSineOsc {
    id: int,
    freq: string,
}

export component AppWindow inherits Window {
    in property <[UiPanningNode]> pans;

    callback connect(int, int, string);
    callback set_root(int);

    callback add_panning();
    callback remove_pan_node(int);
    callback set_pan(int, float);


    in property <[UiPlayerNode]> players;

    callback add_player();
    callback remove_player(int);
    callback play_player(int, string);
    callback pause_player(int);
    callback stop_player(int);
    callback resume_player(int);


    in property <[UiMixerNode]> mixers;

    callback add_mixer();
    callback remove_mixer(int);


    in property <[UiGainNode]> gainers;

    callback add_gainer();
    callback remove_gainer(int);
    callback set_gain(int, float);


    in property <[UiDistorsionNode]> distorsions;

    callback add_distorsion();
    callback remove_distorsion(int);
    callback set_distorsion_mode(int, string);


    in property <[UiSineOsc]> sine_oscs;

    callback add_sine_osc();
    callback remove_sine_osc(int);
    callback set_sine_osc_freq(int, string);


    VerticalLayout {
        HorizontalBox {
            VerticalBox {
                Button {
                    text: "+ Sine Oscs Node";
                    clicked => add_sine_osc();
                }
                ListView {
                    for node in root.sine_oscs : Rectangle {
                        
                        VerticalLayout {
                            HorizontalLayout {
                                Text { text: "Node: " + node.id; }

                                Button {
                                    text: "Set root";
                                    clicked => set_root(node.id);
                                }

                                Button {
                                    text: "X";
                                    clicked => remove_sine_osc(node.id);
                                }
                            }
                            HorizontalBox {
                                Text {
                                    text: "frequency :";
                                }
                                TextInput {
                                    text: node.freq;

                                    edited => set_sine_osc_freq(node.id, self.text);
                                }
                            }
                        }
                    }
                }
            }          

            VerticalBox {
                Button {
                    text: "+ Player Node";
                    clicked => add_player();
                }
                ListView {
                    for node in root.players : Rectangle {
                        
                        VerticalLayout {
                            HorizontalLayout {
                                Text { text: "Node: " + node.id; }

                                Button {
                                    text: "Set root";
                                    clicked => set_root(node.id);
                                }

                                Button {
                                    text: "X";
                                    clicked => remove_player(node.id);
                                }
                            }
                            TextInput {
                                text: node.source_path;
                            }
                            HorizontalLayout {
                                Button {
                                    text: "Play";
                                    clicked => play_player(node.id, node.source_path);
                                }

                                Button {
                                    text: "Pause";
                                    clicked => pause_player(node.id);
                                }

                                Button {
                                    text: "Resume";
                                    clicked => resume_player(node.id);
                                }

                                Button {
                                    text: "Stop";
                                    clicked => stop_player(node.id);
                                }
                            }
                        }
                    }
                }
            }          

            VerticalBox {
                Button {
                    text: "+ Mixer Node";
                    clicked => add_mixer();
                }
                ListView {
                    for node in root.mixers : Rectangle {
                        
                        VerticalLayout {
                            HorizontalLayout {
                                Text { text: "Node: " + node.id; }

                                Button {
                                    text: "Set root";
                                    clicked => set_root(node.id);
                                }

                                Button {
                                    text: "X";
                                    clicked => remove_mixer(node.id);
                                }
                            }
                            HorizontalLayout {
                                spacing: 2px;

                                for i in 10 : HorizontalBox {
                                    Text {
                                        text: "port " + i + ":";
                                    }
                                    TextInput {
                                        text: -1;

                                        edited => {
                                            connect(node.id, i, self.text);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            VerticalBox {
                Button {
                    text: "+ Gain Node";
                    clicked => add_gainer();
                }

                ListView {
                    for node in root.gainers : Rectangle {
                        VerticalLayout {
                            HorizontalLayout {
                                Text { text: "Node: " + node.id; }

                                Button {
                                    text: "Set root";
                                    clicked => set_root(node.id);
                                }

                                Button {
                                    text: "X";
                                    clicked => remove_gainer(node.id);
                                }
                            }
                            HorizontalLayout {
                                Slider {
                                    minimum: 0.0;
                                    maximum: 3.0;
                                    value: node.gain;
                                    changed(value) => set_gain(node.id, value);
                                }

                                Text {
                                    text: "source: ";
                                }
                                TextInput {
                                    text: node.source_id;
                                    width: 60px;

                                    edited => connect(node.id, 0, self.text);
                                }
                            }
                        }
                    }
                }
            }

            VerticalBox {
                Button {
                    text: "+ Panning Node";
                    clicked => add_panning();
                }

                ListView {
                    for node in root.pans : Rectangle {
                        VerticalLayout {
                            HorizontalLayout {
                                Text { text: "Node: " + node.id; }

                                Button {
                                    text: "Set root";
                                    clicked => set_root(node.id);
                                }

                                Button {
                                    text: "X";
                                    clicked => remove_pan_node(node.id);
                                }
                            }
                            HorizontalLayout {
                                Slider {
                                    minimum: 0.0;
                                    maximum: 1.0;
                                    value: node.pan;
                                    changed(value) => set_pan(node.id, value);
                                }

                                Text {
                                    text: "source: ";
                                }
                                TextInput {
                                    text: node.source_id;
                                    width: 60px;

                                    edited => connect(node.id, 0, self.text);
                                }
                            }
                        }
                    }
                }
            }

            VerticalBox {
                Button {
                    text: "+ Distorsion Node";
                    clicked => add_distorsion();
                }

                ListView {
                    for node in root.distorsions : Rectangle {
                        VerticalLayout {
                            HorizontalLayout {
                                Text { text: "Node: " + node.id; }

                                Button {
                                    text: "Set root";
                                    clicked => set_root(node.id);
                                }

                                Button {
                                    text: "X";
                                    clicked => remove_distorsion(node.id);
                                }
                            }
                            HorizontalLayout {
                                ComboBox {
                                    model: ["None", "Soft clip", "Hard clip", "Cubic", "Overdrive", "Stoopid"];

                                    selected(value) => set_distorsion_mode(node.id, value);
                                }

                                Text {
                                    text: "source: ";
                                }
                                TextInput {
                                    text: node.source_id;
                                    width: 60px;

                                    edited => connect(node.id, 0, self.text);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}